# Скопируйте этот файл в .env и заполните значения.
PORT=3000
# NODE_ENV=production

# --- Telegram-бот для заявок ---
# 1) Создайте бота у @BotFather и вставьте токен.
# 2) Напишите боту /start (или добавьте его в группу и отправьте /id) — он пришлёт chat id.
# 3) Впишите chat id (несколько — через запятую; у групп id начинается с минуса).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# --- Eva (ChatGPT) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# За nginx/Cloudflare: учитывать X-Forwarded-For для лимитов по IP
# TRUST_PROXY=1
# Если сайт отдаётся с другого домена, а API работает отдельно:
# ALLOWED_ORIGIN=https://example.ru
