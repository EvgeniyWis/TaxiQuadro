Options -Indexes
DirectoryIndex index.html

# сайт зовёт POST /api/lead — отдаём PHP-обработчик (хостинг без Node.js)
RewriteEngine On
RewriteRule ^api/lead/?$ api/lead.php [L]

# настройки с токенами никогда не отдаём
<FilesMatch "^lead-config.*\.php$">
    Require all denied
</FilesMatch>

# страница всегда проверяется заново, чтобы правки сайта были видны сразу
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
